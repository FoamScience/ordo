# Lock files are resolver output, not code. `linguist-generated=true` collapses
# them in GitHub's diff view and drops them from ordo-tui's review (`--all` keeps
# them). Listed across ecosystems, not just this repo's, so the file stays useful
# as the sample it is referenced as in the README.

Cargo.lock              linguist-generated=true
package-lock.json       linguist-generated=true
npm-shrinkwrap.json     linguist-generated=true
yarn.lock               linguist-generated=true
pnpm-lock.yaml          linguist-generated=true
bun.lock                linguist-generated=true
bun.lockb               linguist-generated=true
deno.lock               linguist-generated=true
uv.lock                 linguist-generated=true
poetry.lock             linguist-generated=true
pdm.lock                linguist-generated=true
Pipfile.lock            linguist-generated=true
go.sum                  linguist-generated=true
go.work.sum             linguist-generated=true
Gemfile.lock            linguist-generated=true
composer.lock           linguist-generated=true
flake.lock              linguist-generated=true
mix.lock                linguist-generated=true
pubspec.lock            linguist-generated=true
Podfile.lock            linguist-generated=true
Package.resolved        linguist-generated=true
Cartfile.resolved       linguist-generated=true
packages.lock.json      linguist-generated=true
gradle.lockfile         linguist-generated=true
shard.lock              linguist-generated=true
renv.lock               linguist-generated=true
stack.yaml.lock         linguist-generated=true
cabal.project.freeze    linguist-generated=true
conan.lock              linguist-generated=true
.terraform.lock.hcl     linguist-generated=true

# Documents that carry generated blocks — the tables between an
# `ordo:begin <key>` / `ordo:end <key>` comment pair are rendered from the code
# that owns them and rewritten by `UPDATE_DOCS=1 cargo test`; the prose around
# them is hand-written. `ordo-generated` is a marker for people and for the
# test that keeps this list honest, and deliberately NOT `linguist-generated`:
# these files are mostly prose, and flagging them would collapse their diffs on
# GitHub and drop them from ordo's own review.

README.md               ordo-generated=true
docs/cli.md             ordo-generated=true
docs/languages.md       ordo-generated=true
docs/reviewing.md       ordo-generated=true
docs/rules.md           ordo-generated=true
docs/tui.md             ordo-generated=true
docs/*.md               linguist-documentation=true
