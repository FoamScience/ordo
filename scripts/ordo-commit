#!/usr/bin/env python3
"""Run ordo on a real git commit with full semantics — the repo-read path that
stays OUT of the engine (ordo core is git-free). Feeds each changed file's parent
blob as `old` and commit blob as `new`, so modified files get full semantics.

Usage: ordo-commit <repo> <sha> [ordo-binary]   (ordo-binary defaults to $ORDO_BIN or `ordo-engine`)
"""
import json
import os
import subprocess
import sys

if len(sys.argv) < 3:
    sys.exit(__doc__)

repo, sha = sys.argv[1], sys.argv[2]
ordo = sys.argv[3] if len(sys.argv) > 3 else os.environ.get("ORDO_BIN", "ordo-engine")
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"


def git(*a):
    return subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True)


parent = git("rev-parse", "--verify", "-q", f"{sha}^").stdout.strip() or EMPTY_TREE
names = git("diff-tree", "--no-commit-id", "--name-only", "-r", sha).stdout.split()

changes = []
for path in names:
    old = git("show", f"{parent}:{path}").stdout if git("cat-file", "-e", f"{parent}:{path}").returncode == 0 else ""
    new = git("show", f"{sha}:{path}").stdout if git("cat-file", "-e", f"{sha}:{path}").returncode == 0 else ""
    changes.append({"path": path, "old": old, "new": new})

inp = json.dumps({"changes": changes, "options": {"strategy": "comprehension", "cross_file": True}})
res = subprocess.run([ordo, "order", "--json"], input=inp, capture_output=True, text=True)
if res.returncode != 0:
    sys.exit(res.stderr)

d = json.loads(res.stdout)
by_id = {h["id"]: (f["path"], h) for f in d["files"] for h in f["hunks"]}
print(f"reading order ({len(d['order'])} hunks across {len(d['files'])} files):\n")
for o in d["order"]:
    path, h = by_id[o["hunk"]]
    print(f"  {path:<28} L{h['new_range'][0]:<4} [{h['category']:<10}] {h['rationale']}")
if d["edges"]:
    print("\ndef→use edges:")
    for e in d["edges"]:
        print(f"  {e['from']} → {e['to']}   {e['why']}")
